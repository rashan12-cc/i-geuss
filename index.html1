<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SYSTEM_FAILURE // DEV_PROFILE_V666.exe</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=VT323&family=Share+Tech+Mono&display=swap" rel="stylesheet">
    <style>
        :root {
            --bg-color: #050505;
            --terminal-bg: #0a0a0a;
            --red-neon: #ff003c;
            --red-dim: #8b0000;
            --text-main: #f0f0f0;
            --text-dim: #a0a0a0;
        }

        body {
            font-family: 'Share Tech Mono', monospace;
            background-color: var(--bg-color);
            color: var(--text-main);
            overflow-x: hidden;
        }

        .font-pixel {
            font-family: 'VT323', monospace;
        }

        /* CRT Scanline and Flicker overlay */
        .crt::before {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: linear-gradient(rgba(18, 16, 16, 0) 50%, rgba(0, 0, 0, 0.25) 50%), linear-gradient(90deg, rgba(255, 0, 0, 0.03), rgba(0, 255, 0, 0.01), rgba(0, 0, 255, 0.03));
            z-index: 99999;
            background-size: 100% 3px, 3px 100%;
            pointer-events: none;
        }

        .crt::after {
            content: " ";
            display: block;
            position: fixed;
            top: 0; left: 0; bottom: 0; right: 0;
            background: rgba(255, 0, 60, 0.02);
            opacity: 0.8;
            z-index: 99998;
            pointer-events: none;
            animation: flicker 0.15s infinite;
        }

        @keyframes flicker {
            0% { opacity: 0.9; }
            50% { opacity: 1; }
            100% { opacity: 0.95; }
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #050505;
        }
        ::-webkit-scrollbar-thumb {
            background: var(--red-dim);
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: var(--red-neon);
        }

        .glow-red {
            text-shadow: 0 0 8px rgba(255, 0, 60, 0.7);
        }
        .box-glow {
            box-shadow: 0 0 20px rgba(255, 0, 60, 0.25);
            border: 1px solid rgba(255, 0, 60, 0.4);
        }

        /* Blinking cursor animation */
        .cursor {
            display: inline-block;
            width: 10px;
            height: 18px;
            background-color: var(--red-neon);
            animation: blink 1s infinite;
            vertical-align: middle;
            margin-left: 4px;
        }

        @keyframes blink {
            0%, 50% { opacity: 1; }
            51%, 100% { opacity: 0; }
        }

        /* Matrix Canvas Background */
        #matrix-canvas {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 1;
            pointer-events: none;
            opacity: 0.15;
        }

        .terminal-content {
            position: relative;
            z-index: 10;
        }
    </style>
</head>
<body class="crt min-h-screen flex flex-col justify-between p-3 md:p-6 select-none md:select-auto">

    <canvas id="matrix-canvas"></canvas>

    <header class="w-full max-w-5xl mx-auto flex flex-col md:flex-row items-center justify-between border-b border-red-900/60 pb-4 mb-4 terminal-content">
        <div class="flex items-center space-x-3 mb-3 md:mb-0">
            <div class="flex space-x-2">
                <span class="w-3 h-3 rounded-full bg-red-600 inline-block shadow-[0_0_8px_#ff0000]"></span>
                <span class="w-3 h-3 rounded-full bg-yellow-600 inline-block shadow-[0_0_8px_#ffcc00]"></span>
                <span class="w-3 h-3 rounded-full bg-green-600 inline-block shadow-[0_0_8px_#00ff00]"></span>
            </div>
            <h1 class="font-pixel text-2xl md:text-3xl text-red-500 tracking-wider glow-red">ROOT@DEV_CONSOLE_v6.66:~#</h1>
        </div>
        <div class="text-xs text-red-400 font-mono flex items-center space-x-4">
            <span class="hidden md:inline">STATUS: <span class="text-red-500 animate-pulse font-bold">CRITICAL_TROLLING</span></span>
            <span id="live-clock">00:00:00</span>
        </div>
    </header>

    <main class="w-full max-w-5xl mx-auto grid grid-cols-1 lg:grid-cols-4 gap-6 flex-grow terminal-content mb-6">
        
        <!-- Sidebar: Profile & Quick Hacks -->
        <div class="lg:col-span-1 flex flex-col space-y-4">
            <!-- Profile Frame -->
            <div class="bg-black/80 box-glow rounded-lg p-4 flex flex-col items-center text-center relative overflow-hidden group">
                <div class="absolute -top-10 -right-10 w-24 h-24 bg-red-600/10 rounded-full blur-xl group-hover:bg-red-600/30 transition-all duration-500"></div>
                
                <!-- Avatar Frame with Trolling Text -->
                <div class="relative w-32 h-32 mb-3 border-2 border-red-600/70 rounded-md p-1 bg-zinc-900 overflow-hidden shadow-[0_0_15px_rgba(255,0,60,0.4)]">
                    <img src="https://placehold.co/150x150/111/ff003c?text=HACKER_CAT" alt="Profile Avatar" class="w-full h-full object-cover rounded filter contrast-125 grayscale hover:grayscale-0 transition-all duration-300" onerror="this.src='https://placehold.co/150x150/111/ff003c?text=ERROR_404'">
                    <div class="absolute bottom-0 inset-x-0 bg-red-950/80 text-[10px] text-red-300 py-0.5 tracking-tighter">WANTED: BROKE PROD</div>
                </div>

                <h2 class="font-pixel text-xl text-red-500 tracking-widest mt-1">LALU "BUG" DEV</h2>
                <p class="text-xs text-zinc-400 mb-3">Senior StackOverflow Engineer & Professional Caffeine Sink</p>

                <div class="w-full border-t border-red-900/40 pt-3 flex flex-col space-y-2 text-xs">
                    <div class="flex justify-between text-zinc-400">
                        <span>Coffee Level:</span>
                        <span class="text-red-500 font-bold">99.9%</span>
                    </div>
                    <div class="flex justify-between text-zinc-400">
                        <span>Sanity:</span>
                        <span class="text-red-500 font-bold">0.02%</span>
                    </div>
                    <div class="flex justify-between text-zinc-400">
                        <span>Production Bugs:</span>
                        <span class="text-red-500 font-bold">∞</span>
                    </div>
                </div>
            </div>

            <!-- Quick Command Buttons (Troll Shortcuts) -->
            <div class="bg-black/80 box-glow rounded-lg p-4 flex flex-col space-y-2">
                <span class="text-xs text-red-500 font-bold uppercase tracking-wider mb-1">// QUICK_EXECUTE</span>
                <button onclick="executeQuickCommand('help')" class="text-left text-xs bg-zinc-900 hover:bg-red-950 text-red-300 hover:text-white px-3 py-2 rounded border border-red-900/50 transition-all flex items-center justify-between">
                    <span>> help</span>
                    <span class="text-[10px] text-zinc-500">list cmds</span>
                </button>
                <button onclick="executeQuickCommand('about')" class="text-left text-xs bg-zinc-900 hover:bg-red-950 text-red-300 hover:text-white px-3 py-2 rounded border border-red-900/50 transition-all flex items-center justify-between">
                    <span>> about</span>
                    <span class="text-[10px] text-zinc-500">whoami</span>
                </button>
                <button onclick="executeQuickCommand('skills')" class="text-left text-xs bg-zinc-900 hover:bg-red-950 text-red-300 hover:text-white px-3 py-2 rounded border border-red-900/50 transition-all flex items-center justify-between">
                    <span>> skills</span>
                    <span class="text-[10px] text-zinc-500">tech stack</span>
                </button>
                <button onclick="executeQuickCommand('projects')" class="text-left text-xs bg-zinc-900 hover:bg-red-950 text-red-300 hover:text-white px-3 py-2 rounded border border-red-900/50 transition-all flex items-center justify-between">
                    <span>> projects</span>
                    <span class="text-[10px] text-zinc-500">fake apps</span>
                </button>
                <button onclick="executeQuickCommand('hire')" class="text-left text-xs bg-zinc-900 hover:bg-red-950 text-red-300 hover:text-white px-3 py-2 rounded border border-red-900/50 transition-all flex items-center justify-between">
                    <span>> hire</span>
                    <span class="text-[10px] text-zinc-500">wallet check</span>
                </button>
                <button onclick="executeQuickCommand('sudo rm -rf /')" class="text-left text-xs bg-red-950/60 hover:bg-red-900 text-red-200 px-3 py-2 rounded border border-red-600 transition-all flex items-center justify-between">
                    <span>> sudo rm -rf /</span>
                    <span class="text-[10px] text-red-400">PANIC</span>
                </button>
            </div>
        </div>

        <!-- Terminal Main Window -->
        <div class="lg:col-span-3 bg-black/90 box-glow rounded-lg flex flex-col h-[550px] overflow-hidden border border-red-600/30">
            <!-- Terminal Toolbar -->
            <div class="bg-zinc-950 px-4 py-2 border-b border-red-900/40 flex items-center justify-between text-xs text-zinc-400">
                <div class="flex items-center space-x-2">
                    <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
                    <span class="font-mono text-red-400">bash - troller@dev-terminal:~</span>
                </div>
                <div class="space-x-2">
                    <button onclick="clearTerminal()" class="hover:text-red-400 transition-colors">[CLEAR]</button>
                    <button onclick="executeQuickCommand('matrix')" class="hover:text-red-400 transition-colors">[MATRIX]</button>
                </div>
            </div>

            <!-- Terminal Output Area -->
            <div id="terminal-output" class="flex-grow p-4 overflow-y-auto space-y-3 text-sm text-red-400/90 font-mono">
                <!-- Initial Welcome Banner -->
                <div class="text-red-500 space-y-1">
                    <pre class="font-pixel text-xs md:text-sm text-red-600 leading-tight">
██████╗ ███████╗██╗   ██╗    ████████╗██████╗  ██████╗ ███╗   ███╗
██╔══██╗██╔════╝██║   ██║    ╚══██╔══╝██╔══██╗██╔═══██╗████╗ ████║
██║  ██║█████╗  ██║   ██║       ██║   ██████╔╝██║   ██║██╔████╔██║
██║  ██║██╔══╝  ╚██╗ ██╔╝       ██║   ██╔══██╗██║   ██║██║╚██╔╝██║
██████╔╝███████╗ ╚████╔╝        ██║   ██║  ██║╚██████╔╝██║ ╚═╝ ██║
╚═════╝ ╚══════╝  ╚═══╝         ╚═╝   ╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝
                    </pre>
                    <p class="text-xs text-zinc-400">SYSTEM SEC_LEVEL: <span class="text-red-500 font-bold">ZERO (ABSOLUTE MAYHEM)</span></p>
                    <p class="text-xs text-zinc-400">Type <span class="text-white bg-red-950 px-1 py-0.5 rounded border border-red-900">help</span> to view available commands or click the shortcuts on the left.</p>
                    <div class="border-b border-red-900/40 my-2"></div>
                </div>
            </div>

            <!-- Terminal Input Bar -->
            <div class="bg-zinc-950 p-3 border-t border-red-900/40 flex items-center">
                <span class="text-red-500 font-bold mr-2">guest@portfolio:~$</span>
                <input type="text" id="terminal-input" autocomplete="off" spellcheck="false" class="flex-grow bg-transparent text-white outline-none font-mono text-sm caret-red-500">
                <button onclick="handleUserInput()" class="bg-red-950 hover:bg-red-900 text-red-300 text-xs px-3 py-1.5 rounded border border-red-800 transition-colors ml-2 font-mono">EXEC</button>
            </div>
        </div>
    </main>

    <footer class="w-full max-w-5xl mx-auto text-center text-xs text-zinc-600 border-t border-red-950 pt-3 terminal-content">
        <p>© 2026 LALU DEV. Built with pure sarcasm, HTML, Tailwind CSS, and zero guarantees.</p>
    </footer>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Live Clock Generator safely guarded
            const clockEl = document.getElementById('live-clock');
            if (clockEl) {
                setInterval(() => {
                    const now = new Date();
                    clockEl.innerText = now.toTimeString().split(' ')[0];
                }, 1000);
            }

            // Matrix Rain Background Effect safely guarded
            const canvas = document.getElementById('matrix-canvas');
            if (canvas) {
                const ctx = canvas.getContext('2d');

                function resizeCanvas() {
                    canvas.width = window.innerWidth;
                    canvas.height = window.innerHeight;
                }
                window.addEventListener('resize', resizeCanvas);
                resizeCanvas();

                const katakana = 'アァカサタナハマヤャラワガザダバパイィキシチニヒミリヰギジヂビピウゥクスツヌフムユュルグズブヅプエェケセテネヘメレヱゲゼデベペオォコソトノホモヨョロヲゴゾドボポヴッン';
                const latin = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789@#$%^&*()_+-=[]{}|;:,.<>/?';
                const alphabet = katakana + latin;

                const fontSize = 16;
                let columns = Math.floor(canvas.width / fontSize);
                let rainDrops = [];

                function initMatrix() {
                    columns = Math.floor(canvas.width / fontSize);
                    rainDrops = [];
                    for (let x = 0; x < columns; x++) {
                        rainDrops[x] = 1;
                    }
                }
                initMatrix();

                function drawMatrix() {
                    ctx.fillStyle = 'rgba(5, 5, 5, 0.05)';
                    ctx.fillRect(0, 0, canvas.width, canvas.height);

                    ctx.fillStyle = '#ff003c';
                    ctx.font = fontSize + 'px monospace';

                    for (let i = 0; i < rainDrops.length; i++) {
                        const text = alphabet.charAt(Math.floor(Math.random() * alphabet.length));
                        ctx.fillText(text, i * fontSize, rainDrops[i] * fontSize);

                        if (rainDrops[i] * fontSize > canvas.height && Math.random() > 0.975) {
                            rainDrops[i] = 0;
                        }
                        rainDrops[i]++;
                    }
                }
                let matrixInterval = setInterval(drawMatrix, 30);

                // Expose matrix speed trigger safely
                window.triggerMatrixSpeedBoost = function() {
                    clearInterval(matrixInterval);
                    matrixInterval = setInterval(drawMatrix, 10);
                    setTimeout(() => {
                        clearInterval(matrixInterval);
                        matrixInterval = setInterval(drawMatrix, 30);
                    }, 3000);
                };
            }

            // Terminal Interactive Logic safely guarded
            const terminalOutput = document.getElementById('terminal-output');
            const terminalInput = document.getElementById('terminal-input');

            const responses = {
                'help': `
                    <div class="space-y-1 text-zinc-300">
                        <p class="text-red-500 font-bold">// AVAILABLE COMMANDS:</p>
                        <p><span class="text-white font-bold">about</span>      - Reveals the tragic truth behind this developer.</p>
                        <p><span class="text-white font-bold">skills</span>     - Displays professional and totally legitimate skills.</p>
                        <p><span class="text-white font-bold">projects</span>   - Showcases fake apps guaranteed to crash your browser.</p>
                        <p><span class="text-white font-bold">hire</span>       - Tries to calculate how much you cannot afford me.</p>
                        <p><span class="text-white font-bold">matrix</span>     - Toggles the red matrix rain speed/intensity.</p>
                        <p><span class="text-white font-bold">clear</span>      - Clears the terminal screen.</p>
                        <p><span class="text-white font-bold">sudo rm -rf /</span> - Triggers immediate panic protocol.</p>
                    </div>
                `,
                'about': `
                    <div class="space-y-2 text-zinc-300">
                        <p class="text-red-500 font-bold">> WHOAMI: LALU DEV</p>
                        <p>I am a professional StackOverflow copy-paste architect and a grandmaster at centering divs using absolute luck and prayer.</p>
                        <p>My code works on my machine. If it breaks on yours, that's clearly a hardware issue on your end. ¯\\_(ツ)_/¯ </p>
                    </div>
                `,
                'skills': `
                    <div class="space-y-2 text-zinc-300">
                        <p class="text-red-500 font-bold">> TECH_STACK & EXPERTISE:</p>
                        <ul class="list-disc list-inside space-y-1">
                            <li><span class="text-white">HTML5</span> - My absolute favorite programming language (just kidding, please don't yell at me).</li>
                            <li><span class="text-white">CSS / Tailwind</span> - Centering things by randomly changing flex properties until it looks okay.</li>
                            <li><span class="text-white">JavaScript</span> - Fixing "undefined is not a function" by throwing more console.logs at it.</li>
                            <li><span class="text-white">Debugging</span> - Staring blankly at the screen until the computer gets intimidated and fixes itself.</li>
                        </ul>
                    </div>
                `,
                'projects': `
                    <div class="space-y-3 text-zinc-300">
                        <p class="text-red-500 font-bold">> FEATURED_PROJECTS:</p>
                        <div class="border-l-2 border-red-600 pl-3 space-y-1">
                            <p class="text-white font-bold">1. Self-Driving Toaster (v1.0)</p>
                            <p class="text-xs text-zinc-400">A toaster equipped with AI that burns your toast with machine learning precision.</p>
                        </div>
                        <div class="border-l-2 border-red-600 pl-3 space-y-1">
                            <p class="text-white font-bold">2. App That Deletes System32 (Trust Me)</p>
                            <p class="text-xs text-zinc-400">100% safe app. Free RAM download included. Definitely not a virus.</p>
                        </div>
                    </div>
                `,
                'hire': `
                    <div class="space-y-2 text-red-400">
                        <p class="font-bold">> WALLET_CHECK_INITIALIZED...</p>
                        <p class="text-zinc-300">Error 402: You definitely cannot afford my hourly rate of 1 Million cups of espresso and an unlimited supply of pizza.</p>
                        <p class="text-xs text-zinc-400">Send an email anyway if you dare: <span class="text-white underline">troll@dev-console.local</span></p>
                    </div>
                `,
                'sudo rm -rf /': `
                    <div class="bg-red-950/80 border border-red-600 p-4 rounded text-white space-y-2 animate-pulse">
                        <p class="font-bold text-red-400">KERNEL PANIC: SYSTEM FILES WIPED!</p>
                        <p class="text-xs">Just kidding! Did you really think I'd let a guest run root commands? Nice try, hacker wannabe. 😉</p>
                    </div>
                `,
                'matrix': `
                    <div class="text-red-400">
                        <p>> Matrix rain frequency scrambled! Welcome deeper into the rabbit hole.</p>
                    </div>
                `,
                'clear': 'CLEAR'
            };

            window.escapeHtml = function(text) {
                return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            };

            window.printToTerminal = function(command, outputHtml) {
                if (!terminalOutput) return;
                const cmdDiv = document.createElement('div');
                cmdDiv.innerHTML = `<span class="text-zinc-500">guest@portfolio:~$</span> <span class="text-white">${window.escapeHtml(command)}</span>`;
                terminalOutput.appendChild(cmdDiv);

                if (outputHtml === 'CLEAR') {
                    terminalOutput.innerHTML = '';
                } else if (outputHtml) {
                    const outDiv = document.createElement('div');
                    outDiv.className = 'my-2 pl-2';
                    outDiv.innerHTML = outputHtml;
                    terminalOutput.appendChild(outDiv);
                }

                terminalOutput.scrollTop = terminalOutput.scrollHeight;
            };

            window.clearTerminal = function() {
                if (terminalOutput) {
                    terminalOutput.innerHTML = '';
                }
            };

            window.handleUserInput = function() {
                if (!terminalInput) return;
                const val = terminalInput.value.trim().toLowerCase();
                if (!val) return;

                if (val === 'clear') {
                    window.clearTerminal();
                    terminalInput.value = '';
                    return;
                }

                if (val === 'matrix' && typeof window.triggerMatrixSpeedBoost === 'function') {
                    window.triggerMatrixSpeedBoost();
                }

                const response = responses[val] || `<span class="text-red-500">Command not recognized: "${window.escapeHtml(val)}". Type <span class="text-white underline">help</span> for valid commands. Stop making things up!</span>`;
                
                window.printToTerminal(val, response);
                terminalInput.value = '';
            };

            window.executeQuickCommand = function(cmd) {
                if (terminalInput) {
                    terminalInput.value = cmd;
                    window.handleUserInput();
                }
            };

            if (terminalInput) {
                terminalInput.addEventListener('keydown', function(e) {
                    if (e.key === 'Enter') {
                        window.handleUserInput();
                    }
                });
            }
        });
    </script>
</body>
</html>
